# Environment Profile (dev, test, e2e, staging)
SPRING_PROFILES_ACTIVE=staging
PORT=8080

# PostgreSQL Database Configuration (Managed Cloud / Local)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=evmanager
DB_USERNAME=postgres
DB_PASSWORD=your_secure_db_password
DB_SSL_MODE=require

# Optional Full JDBC URL (Render/Railway/Neon/Supabase)
# DATABASE_URL=jdbc:postgresql://host:5432/evmanager?sslmode=require

# JWT Secret (Base64 string, minimum 256 bits, mandatory for Staging)
JWT_SECRET=your_super_secret_jwt_key_that_is_at_least_256_bits_long_example

# Allowed Frontend Origins (comma-separated, no trailing slashes)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Optional Mail / SMTP Configuration
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
