# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=evmanager
DB_USERNAME=postgres
DB_PASSWORD=postgres

# JWT Secret (Base64 encoded string, should be at least 256 bits)
JWT_SECRET=your_super_secret_jwt_key_that_is_at_least_256_bits_long_example

# Mail / SMTP Configuration
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_FROM=no-reply@evmanager.vn
MAIL_FROM_NAME="EVManager - Trung Tâm Hội Nghị & Tiệc Cưới"
MAIL_ENABLED=true
