# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=evmanager
DB_USERNAME=postgres
DB_PASSWORD=postgres

# JWT Secret (Base64 encoded string, should be at least 256 bits)
JWT_SECRET=your_super_secret_jwt_key_that_is_at_least_256_bits_long_example

# CORS Configuration (comma-separated allowed origins)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Rate Limiting Configuration
RATE_LIMIT_DEFAULT_PER_MIN=100
RATE_LIMIT_LOGIN_PER_MIN=5
RATE_LIMIT_TRUST_FORWARDED_HEADERS=false
